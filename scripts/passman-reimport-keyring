#!/usr/bin/env bash
#
# Re-import from gnome-keyring without giving it back the session.
#
# The obvious way to read gnome-keyring again — stop passman, start
# gnome-keyring, import, swap back — takes org.freedesktop.secrets away from
# every running application for the duration. They do not all cope: some cache
# the name owner, some fall back to storing secrets in the clear.
#
# So this runs gnome-keyring on a *private* D-Bus session instead. It reads the
# same ~/.local/share/keyrings files, claims org.freedesktop.secrets on a bus
# nobody else is connected to, and the import talks to that. Your real session
# keeps passman throughout, and nothing on it notices this happened.
#
# The reason you would run this: passman's importer used to convert secrets
# through a lossy string conversion, which destroyed every *binary* one —
# notably the XDG portal application keys, which are 64 random bytes each.
# Text secrets were unaffected. `--replace` overwrites what the vault holds
# rather than skipping it as a duplicate, which is what makes a re-import able
# to repair a bad one.
#
set -uo pipefail

say()  { printf '\033[1;34m::\033[0m %s\n' "$*"; }
ok()   { printf '\033[1;32m ✓\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m !\033[0m %s\n' "$*"; }
die()  { printf '\033[1;31m ✗\033[0m %s\n' "$*" >&2; exit 1; }

VAULT="${PASSMAN_VAULT:-$HOME/.local/share/passman/default.vault}"
KEYRING_DIR="$HOME/.local/share/keyrings"
DRY=0
REPLACE=--replace

usage() {
    cat <<EOF
passman-reimport-keyring — re-read gnome-keyring on a private bus

  --dry-run     report what would be read, write nothing
  --no-replace  skip items the vault already holds instead of overwriting
  -h, --help    this text

Needs your login password, which is what gnome-keyring's own keyring files are
encrypted with. It is read straight into gnome-keyring's stdin and never
appears on a command line, in the environment, or in this script's output.
EOF
}

while [ $# -gt 0 ]; do
    case "$1" in
        --dry-run) DRY=1 ;;
        --no-replace) REPLACE= ;;
        -h|--help) usage; exit 0 ;;
        *) die "unknown option: $1 (try --help)" ;;
    esac
    shift
done

command -v gnome-keyring-daemon >/dev/null 2>&1 \
    || die "gnome-keyring-daemon is not installed; nothing to read from"
command -v dbus-daemon >/dev/null 2>&1 || die "dbus-daemon is not installed"
[ -d "$KEYRING_DIR" ] || die "no keyring files at $KEYRING_DIR"
[ -f "$VAULT" ] || die "no vault at $VAULT"

CLI="$(command -v passman-cli || echo "$HOME/.local/bin/passman-cli")"
[ -x "$CLI" ] || die "passman-cli not found"

say "Keyring files found"
for f in "$KEYRING_DIR"/*.keyring; do
    [ -e "$f" ] && printf '   %s (%s bytes)\n' "$(basename "$f")" "$(stat -c%s "$f")"
done

# --- the private bus -------------------------------------------------------
#
# Everything below runs against BUS_ADDR. The real session bus is never
# touched, so passman keeps serving org.freedesktop.secrets throughout.
BUS_INFO="$(dbus-daemon --session --print-address --fork --print-pid)" \
    || die "could not start a private bus"
BUS_ADDR="$(printf '%s\n' "$BUS_INFO" | head -1)"
BUS_PID="$(printf '%s\n' "$BUS_INFO" | tail -1)"
GK_PID=""

cleanup() {
    [ -n "$GK_PID" ] && kill "$GK_PID" 2>/dev/null
    [ -n "$BUS_PID" ] && kill "$BUS_PID" 2>/dev/null
}
trap cleanup EXIT INT TERM

say "Started a private bus (pid $BUS_PID); your session is untouched"

# --- gnome-keyring on that bus ---------------------------------------------
say "Unlocking gnome-keyring"
printf '   %s\n' "This is your login password, not your passman passphrase."
printf '   Login password: ' >&2
read -rs LOGIN_PW
printf '\n' >&2

# `--unlock` reads the password from stdin, which is how PAM has always driven
# it: never an argument, so it cannot show up in ps output or shell history.
GK_OUT="$(printf '%s' "$LOGIN_PW" \
    | DBUS_SESSION_BUS_ADDRESS="$BUS_ADDR" \
      gnome-keyring-daemon --unlock --components=secrets 2>/dev/null)"
GK_RC=$?
unset LOGIN_PW

if [ $GK_RC -ne 0 ]; then
    die "gnome-keyring refused the password, or failed to start"
fi
GK_PID="$(printf '%s\n' "$GK_OUT" | sed -n 's/^GNOME_KEYRING_PID=\([0-9]*\).*/\1/p')"
sleep 1

owner="$(DBUS_SESSION_BUS_ADDRESS="$BUS_ADDR" \
    busctl --user list --no-pager 2>/dev/null | grep -c '^org.freedesktop.secrets')"
[ "${owner:-0}" -gt 0 ] || die "gnome-keyring did not claim the Secret Service on the private bus"

# Owning the name is not the same as being readable. A wrong password does not
# stop gnome-keyring starting — it starts anyway and leaves the keyring locked,
# so without this check the import would cheerfully read zero items and report
# success. Ask the default collection whether it is still locked.
default_coll="$(DBUS_SESSION_BUS_ADDRESS="$BUS_ADDR" busctl --user call \
    org.freedesktop.secrets /org/freedesktop/secrets \
    org.freedesktop.Secret.Service ReadAlias s default 2>/dev/null \
    | grep -o '"/[^"]*"' | tr -d '"')"
if [ -z "$default_coll" ] || [ "$default_coll" = "/" ]; then
    die "gnome-keyring exposes no default collection; the password was probably wrong"
fi
locked="$(DBUS_SESSION_BUS_ADDRESS="$BUS_ADDR" busctl --user get-property \
    org.freedesktop.secrets "$default_coll" \
    org.freedesktop.Secret.Collection Locked 2>/dev/null | awk '{print $2}')"
if [ "$locked" != "false" ]; then
    die "the keyring is still locked — that password does not open it"
fi
ok "gnome-keyring is serving the private bus, unlocked"

# --- the import ------------------------------------------------------------
if [ "$DRY" = 1 ]; then
    say "Reading (dry run — nothing will be written)"
    DBUS_SESSION_BUS_ADDRESS="$BUS_ADDR" "$CLI" --vault "$VAULT" import --dry-run
    exit 0
fi

say "Importing into $VAULT"
[ -n "$REPLACE" ] && printf '   %s\n' \
    "Items already in the vault will be overwritten with what gnome-keyring holds."
DBUS_SESSION_BUS_ADDRESS="$BUS_ADDR" "$CLI" --vault "$VAULT" import $REPLACE \
    || die "the import failed; the vault is unchanged unless it reported otherwise"

ok "done"
printf '\n   %s\n' "Restart passmand so it serves the repaired items:"
printf '     systemctl --user restart passman-daemon.service\n'
