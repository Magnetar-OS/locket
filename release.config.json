{
  "versionFiles": [
    "Cargo.toml",
    {
      "path": "Cargo.toml",
      "pattern": "^locket-[a-z]+ = \\{ path = \"[^\"]+\", version = \"([^\"]+)\"",
      "all": true
    },
    {
      "path": "Cargo.lock",
      "pattern": "\\[\\[package\\]\\]\\nname = \"locket-[a-z]+\"\\nversion = \"(.+)\"",
      "all": true
    },
    "res/com.magnetaros.Locket.metainfo.xml",
    {
      "path": "extension/manifest.json",
      "pattern": "\"version\": \"([^\"]+)\""
    },
    {
      "path": "extension/manifest.firefox.json",
      "pattern": "\"version\": \"([^\"]+)\""
    }
  ],
  "publish": null,
  "steps": [
    "version",
    "changelog",
    "tag",
    "push"
  ]
}
