# Maintainer: Dominikos Pritis <hey@myroomie.gr>
#
# A -git package because nothing is tagged yet. When there is a release, this
# becomes `locket` with a fixed source tarball and no pkgver().
#
# The package installs the pieces and stops there. It does not claim
# org.freedesktop.secrets, enable the user unit, or edit any PAM stack: taking
# over the session's secret store is a decision the person using the machine
# makes, after they have imported what their current keyring is holding. See
# the post-install message.
pkgname=locket-git
pkgver=0.1.0.r0.gHEAD
pkgrel=1
pkgdesc="Password and secrets manager for COSMIC: Secret Service, Secret portal and SSH agent"
arch=('x86_64' 'aarch64')
url="https://github.com/idominikos/locket"
license=('GPL-3.0-or-later')
# From what the release binaries actually link against, not from guesswork:
#   libtss2-*      tpm2-tss     TPM-sealed key slots
#   libudev        systemd-libs hidapi's Linux backend, for FIDO2 tokens
#   libxkbcommon   libcosmic
#   libcrypto      openssl
depends=('tpm2-tss' 'systemd-libs' 'libxkbcommon' 'openssl' 'zlib' 'zstd' 'brotli' 'pam')
# Unversioned on purpose: `rustup` provides `rust` and `cargo` without a
# version, so a versioned makedepend can never be satisfied on a machine using
# it. The minimum is `rust-version` in Cargo.toml, and cargo says so plainly if
# the toolchain is older.
makedepends=('cargo' 'git' 'pkgconf')
optdepends=(
  'xdg-desktop-portal: per-application secrets for sandboxed Flatpak apps'
  'sqlite: reading gcloud credentials during import'
  'gnupg: reading a pass (password-store) tree during import'
)
provides=('locket')
conflicts=('locket')
install="$pkgname.install"
source=("$pkgname::git+https://github.com/idominikos/locket.git")
sha256sums=('SKIP')
options=('!lto')  # the workspace sets its own lto in Cargo.toml

pkgver() {
  cd "$srcdir/$pkgname"
  # 0.1.0.r<commits>.g<hash> — sorts correctly and says which commit it is.
  printf "%s.r%s.g%s" \
    "$(awk -F'"' '/^version/ {print $2; exit}' Cargo.toml)" \
    "$(git rev-list --count HEAD)" \
    "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$srcdir/$pkgname"
  # Fetch now so build() can run offline, which is what makechrootpkg expects.
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$srcdir/$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release \
    -p locket-cosmic -p locket-daemon -p locket-cli \
    -p locket-applet -p locket-nmh -p locket-pam
}

check() {
  cd "$srcdir/$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  # The hardware tests are #[ignore]d behind environment variables; everything
  # else runs without a TPM, a token or a display.
  cargo test --frozen --workspace --exclude locket-cosmic --exclude locket-applet
}

package() {
  cd "$srcdir/$pkgname"

  install -Dm755 target/release/locket             "$pkgdir/usr/bin/locket"
  install -Dm755 target/release/locketd            "$pkgdir/usr/bin/locketd"
  install -Dm755 target/release/locket-cli         "$pkgdir/usr/bin/locket-cli"
  install -Dm755 target/release/locket-applet      "$pkgdir/usr/bin/locket-applet"
  install -Dm755 target/release/locket-native-host "$pkgdir/usr/bin/locket-native-host"

  # PAM module. Installed, not wired: adding it to a login stack is the
  # installer's job, with a backup and a check that sudo still works.
  install -Dm755 target/release/libpam_locket.so "$pkgdir/usr/lib/security/pam_locket.so"

  install -Dm644 res/io.github.idominikos.Locket.desktop \
    "$pkgdir/usr/share/applications/io.github.idominikos.Locket.desktop"
  install -Dm644 res/io.github.idominikos.LocketApplet.desktop \
    "$pkgdir/usr/share/applications/io.github.idominikos.LocketApplet.desktop"
  install -Dm644 res/io.github.idominikos.Locket.metainfo.xml \
    "$pkgdir/usr/share/metainfo/io.github.idominikos.Locket.metainfo.xml"
  install -Dm644 res/icons/hicolor/scalable/apps/io.github.idominikos.Locket.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.idominikos.Locket.svg"
  install -Dm644 res/icons/hicolor/symbolic/apps/io.github.idominikos.Locket-symbolic.svg \
    "$pkgdir/usr/share/icons/hicolor/symbolic/apps/io.github.idominikos.Locket-symbolic.svg"

  # The portal backend file has to live where xdg-desktop-portal scans, which
  # is XDG_DATA_DIRS only — a copy under ~/.local/share is never found.
  install -Dm644 res/locket.portal \
    "$pkgdir/usr/share/xdg-desktop-portal/portals/locket.portal"

  install -Dm644 res/locket-daemon.service \
    "$pkgdir/usr/lib/systemd/user/locket-daemon.service"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 SECURITY.md "$pkgdir/usr/share/doc/$pkgname/SECURITY.md"
  install -Dm644 res/pam-install.md "$pkgdir/usr/share/doc/$pkgname/pam-install.md"
}
