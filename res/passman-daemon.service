[Unit]
Description=passman secrets daemon
Documentation=https://github.com/idominikos/passman
# The unlock socket lives in %t (/run/user/<uid>), so the runtime dir must
# exist first. pam_systemd is what creates it.
After=dbus.socket
PartOf=graphical-session.target

[Service]
Type=simple
# Starts locked on purpose: nobody has typed anything yet at login time.
# pam_passman.so unlocks it, or the frontend does.
#
# --replace-keyring is load-bearing here. D-Bus activation for
# org.freedesktop.secrets delegates to this unit via SystemdService=, so the
# Exec= line in the .service file is never used — these flags are the only
# thing that claims the Secret Service name. Without it the daemon starts on
# org.passman.secrets and nothing owns org.freedesktop.secrets at all.
#
# --auto-lock drops the key after 15 minutes with nothing asking for a secret
# and nothing using the SSH agent. The frontend has its own idle timer, but it
# only covers its own window; this one covers the session. The vault is also
# locked when the session locks or the machine suspends, which needs no flag.
ExecStart=/usr/bin/passmand --replace-keyring --locked --unlock-socket --ssh-agent --portal --auto-lock 900
Restart=on-failure
RestartSec=2

# The vault is the whole point; give the process as little else as possible.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-write
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
# Keep the vault out of a core dump.
LimitCORE=0

[Install]
WantedBy=graphical-session.target
