[Desktop Entry]
Type=Application
Name=Passman
GenericName=Password Manager
Comment=Passwords, keys and secrets for the COSMIC desktop
Exec=passman
Icon=io.github.idominikos.Passman
Terminal=false
Categories=Utility;Security;
Keywords=password;secret;keyring;keychain;ssh;otp;totp;credential;
StartupNotify=true
StartupWMClass=io.github.idominikos.Passman
X-GNOME-UsesNotifications=true
